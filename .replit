modules = ["java-21", "nodejs-22", "postgresql-16", "python-base-3.13"]
hidden  = [".idea", ".vscode", "target", "node_modules", "generated-sources", ".cache"]

[nix]
channel = "stable-24_11"

# === Deployment === Reserved VM (`gce`). Build + run wrapped in scripts.
[deployment]
deploymentTarget = "gce"
build = ["bash", "scripts/replit-build.sh"]
run   = ["bash", "scripts/replit-run.sh"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

# === Workspace env ===
[env]
PORT = "5000"
SPRING_PROFILES_ACTIVE = "replit"
VITE_CLERK_JWT_TEMPLATE = "aidigital-api"

[workflows]
runButton = "Run"

[[workflows.workflow]]
name = "Run"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit-dev-backend.sh"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/replit-dev-frontend.sh"

[agent]
expertMode = true

[userenv]

[userenv.shared]
AUTH_ALLOWED_EMAIL_DOMAIN = "aidigital.com"
AUTH_AUTHORIZED_PARTIES = "https://de1ddd8c-7885-4345-bdff-dbff942be7e0-00-3bdhs3ngq2l9d.spock.replit.dev,http://localhost:5173,http://localhost:5000,https://presentation-builder-poc.replit.app, https://8d9e6b9d-0617-4312-8425-b6ab0ae8a4a3-00-35be4q03aylh0.worf.replit.dev,https://aiae-presentation-builder.aidigital.tech"

# Base values = Replit workspace (dev Clerk instance). The published app
# overrides them with the PRD_* twins below; scripts/lib/deploy-env.sh does
# the swap and is sourced only by the [deployment] build/run scripts.
CLERK_PUBLISHABLE_KEY = "pk_test_bGl2aW5nLWluc2VjdC02MC5jbGVyay5hY2NvdW50cy5kZXYk"
APP_SECURITY_CSP_FRAME_ANCESTORS = "'self' https://*.replit.dev https://aiae-presentation-builder.aidigital.tech"

PRD_CLERK_PUBLISHABLE_KEY = "pk_live_Y2xlcmsuYWlkaWdpdGFsLnRlY2gk"
PRD_APP_SECURITY_CSP_FRAME_ANCESTORS = "'self' https://aiae-presentation-builder.aidigital.tech"
PRD_AUTH_AUTHORIZED_PARTIES = "https://aiae-presentation-builder.aidigital.tech"
