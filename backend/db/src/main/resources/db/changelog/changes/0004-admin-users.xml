<?xml version="1.0" encoding="UTF-8"?>
<!--
  UI-managed admin grants. The server `app.admin.emails` allow-list stays the
  root/bootstrap admins (not stored here, never removable); this table holds the
  additional admins granted through the admin UI.
-->
<databaseChangeLog
		xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

	<changeSet id="admin-users-initial" author="agent">
		<createTable tableName="admin_users">
			<column name="id" type="BIGINT" autoIncrement="true">
				<constraints primaryKey="true" nullable="false"/>
			</column>
			<column name="email" type="TEXT">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="added_by_email" type="TEXT"/>
			<column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
				<constraints nullable="false"/>
			</column>
		</createTable>
	</changeSet>

</databaseChangeLog>
